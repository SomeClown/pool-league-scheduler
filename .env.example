# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it later logs every user out. Never commit the real .env.
SECRET_KEY=

# DATABASE_URL is intentionally absent: docker-compose.prod.yml sets it to
# the container path (sqlite:////data/league.db) and overrides anything
# put here.

# Pin the image to a release tag or sha-<short> instead of floating on
# latest; scripts/deploy.sh --rollback TAG overrides this for one run.
# TAG=
